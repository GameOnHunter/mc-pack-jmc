# Normalize known text formats to LF, in the repo and on checkout
*.cfg      text eol=lf
*.toml     text eol=lf
*.json     text eol=lf
*.txt      text eol=lf
*.properties text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Anything not listed above: leave completely alone (treat as binary)
* -text